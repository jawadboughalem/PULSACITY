{
  "name": "pulsacity",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @pulsacity/corporate dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @pulsacity/corporate test:e2e",
    "db:generate": "pnpm --filter @pulsacity/db generate",
    "db:migrate": "pnpm --filter @pulsacity/db migrate",
    "db:seed": "pnpm --filter @pulsacity/db seed",
    "showcase:shots": "pnpm --filter @pulsacity/corporate showcase:shots",
    "brand:assets": "pnpm --filter @pulsacity/design brand:assets"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver",
      "@tailwindcss/oxide"
    ]
  }
}
