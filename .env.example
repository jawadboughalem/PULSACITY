# =============================================================================
# PULSACITY — variables d'environnement
#
# Copiez ce fichier en `.env.local` (jamais commité) et remplissez les valeurs.
# Une variable vide reste vide : le code omet la ligne correspondante plutôt que
# d'inventer une valeur. Aucun secret ne doit être écrit en dur dans le code.
# =============================================================================

# -----------------------------------------------------------------------------
# Hôtes (routage par domaine)
# -----------------------------------------------------------------------------
# Domaine de la page corporate. `www.` redirige en 308 vers l'apex.
NEXT_PUBLIC_CORPORATE_HOST=pulsacity.com
# Domaine qui sert les démos client (toujours noindex).
NEXT_PUBLIC_DEMO_HOST=demo.pulsacity.com
# En développement, utilisez plutôt :
#   NEXT_PUBLIC_CORPORATE_HOST=pulsacity.localhost:3000
#   NEXT_PUBLIC_DEMO_HOST=demo.localhost:3000

# Durée de vie d'une démo, en jours. Passé ce délai la page affiche
# « Cette démo n'est plus disponible ».
DEMO_TTL_DAYS=30

# -----------------------------------------------------------------------------
# Base de données (Supabase Postgres)
# -----------------------------------------------------------------------------
# Pooler Supabase en mode *transaction* (port 6543) pour l'application.
# Le mode transaction interdit les requêtes préparées : le client force `prepare: false`.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Connexion directe (port 5432), utilisée uniquement par `pnpm db:migrate`.
# Laissez vide pour réutiliser DATABASE_URL.
DIRECT_DATABASE_URL=

# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------
# Clés de test par défaut (`sk_test_…`). Passez en `sk_live_…` le jour de la mise en production.
STRIPE_SECRET_KEY=sk_test_
# Secret de signature de l'endpoint /api/stripe/webhook (`whsec_…`).
STRIPE_WEBHOOK_SECRET=whsec_
# Régime de TVA :
#   franchise = micro-entreprise (défaut) → 500 € encaissés, mention art. 293 B du CGI
#   standard  = SASU assujettie           → TVA 20 % exclusive, soit 600 € TTC
VAT_MODE=franchise
# Identifiant du taux de TVA Stripe (`txr_…`), 20 % exclusif.
# Obligatoire uniquement si VAT_MODE=standard.
STRIPE_TAX_RATE_ID=

# Le prix n'est PAS une variable d'environnement : il est déclaré dans le fichier de la
# ligne concernée (`apps/corporate/content/lines/<slug>.json`) et lu côté serveur.
# Les coordonnées affichées sur la page vivent dans `apps/corporate/content/site.json`.

# -----------------------------------------------------------------------------
# E-mails transactionnels (Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_
# Expéditeur : doit appartenir à un domaine vérifié chez Resend (DKIM + SPF).
EMAIL_FROM=PULSACITY <contact@pulsacity.com>
# Destinataire interne des ventes et des demandes de site.
OWNER_EMAIL=

# -----------------------------------------------------------------------------
# Identité légale (pages /mentions-legales, /confidentialite, /cgv)
# Une variable vide supprime la ligne qui la contient.
# -----------------------------------------------------------------------------
LEGAL_NAME=
# Ex. « Entrepreneur individuel », « SASU au capital de 1 000 € ».
LEGAL_STATUS=
# Laisser vide tant que la micro-entreprise n'est pas immatriculée.
LEGAL_SIRET=
LEGAL_ADDRESS=
# Adresse de contact pour l'exercice des droits RGPD.
LEGAL_EMAIL=
# Directeur de la publication, si différent de LEGAL_NAME.
LEGAL_PUBLISHER=
# Coordonnées postales de l'hébergeur, à recopier depuis la page légale de Vercel.
# Ne jamais les écrire de mémoire.
LEGAL_HOST_ADDRESS=

# -----------------------------------------------------------------------------
# Fourni automatiquement par Vercel — ne pas définir à la main
# -----------------------------------------------------------------------------
# VERCEL_ENV=production|preview|development
