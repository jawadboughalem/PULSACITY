# PULSACITY — variables d'environnement
#
# Copiez ce fichier en .env.local pour le développement et remplissez les valeurs.
# Aucune valeur réelle n'est commitée : en production, elles vivent dans Vercel.

# --- Base de données -------------------------------------------------------------------------

# Projet Supabase neuf, utilisé uniquement comme Postgres.
# Chaîne du pooler en mode transaction (port 6543), de la forme :
# postgres://postgres.<ref-du-projet>:<mot-de-passe>@<hôte-du-pooler>:6543/postgres
DATABASE_URL=

# --- Connexion (Better Auth, lien magique) ---------------------------------------------------

# Secret aléatoire d'au moins 32 caractères, par exemple : openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL publique de l'application. En local : http://localhost:3000
BETTER_AUTH_URL=

# --- E-mails (Resend) -------------------------------------------------------------------------

RESEND_API_KEY=
# Domaine d'envoi, par exemple : envois.pulsacity.com
EMAIL_FROM_DOMAIN=

# --- Abonnements PULSACITY (Stripe Billing) ---------------------------------------------------

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Identifiants des prix Stripe (price_…) des plans payants.
STRIPE_PRICE_ESSENTIEL_MONTHLY=
STRIPE_PRICE_ESSENTIEL_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# --- Photos (Cloudflare R2) -------------------------------------------------------------------

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# --- Envoi des demandes planifiées (Vercel Cron) ----------------------------------------------

# Vercel Cron l'envoie dans l'en-tête Authorization de chaque appel.
CRON_SECRET=

# --- Application ------------------------------------------------------------------------------

# URL publique, par exemple : https://pulsacity.com
NEXT_PUBLIC_APP_URL=

# --- Suivi des erreurs (Sentry) ---------------------------------------------------------------

# Vide : Sentry reste éteint et le build passe. Un DSN est public par nature : il est aussi
# transmis au navigateur, au moment du build.
SENTRY_DSN=

# --- Textes légaux -----------------------------------------------------------------------------

# false tant que les textes ne sont pas relus.
LEGAL_VALIDATED=false
